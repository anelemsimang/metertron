# Supabase → Project Settings → Database → Connection string → Transaction pooler.
# Prefer session mode (5432) for RLS GUCs when available; transaction pooler (6543) works with max:1.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Public site URL (marketing canonicals, email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Photo object storage. fs = local .data/storage; none = skip disk (CI/tests).
STORAGE_DRIVER=fs
# STORAGE_ROOT=.data/storage

# Paystack (optional). Leave unset to use the local stub checkout provider.
# PAYSTACK_SECRET_KEY=sk_test_…
# PAYSTACK_PUBLIC_KEY=pk_test_…

# Email (optional). Without RESEND_API_KEY, emails are logged as stubs.
# RESEND_API_KEY=re_…
# EMAIL_FROM=Metertron <noreply@metertron.co.za>
# MARKETING_LEADS_EMAIL=hello@metertron.co.za

# Marketing (optional)
# WhatsApp click-to-chat (digits with country code, no +). Defaults to Orlin 27837915151 if unset.
# NEXT_PUBLIC_WHATSAPP_NUMBER=27837915151
# NEXT_PUBLIC_CALENDAR_URL=https://…
# NEXT_PUBLIC_STATUS_URL=https://status.example.com

# Online checkout is OFF by default (private payment arrangements). Set true later to re-enable Paystack/stub checkout.
# BILLING_CHECKOUT_ENABLED=false
# PAYSTACK keys only needed when BILLING_CHECKOUT_ENABLED=true


# Platform control panel bootstrap (npm run platform:bootstrap) — local/ops only; not required for the web app runtime.
# PLATFORM_BOOTSTRAP_EMAIL=owner@example.com
# PLATFORM_BOOTSTRAP_PASSWORD=replace-with-a-long-secret
# PLATFORM_BOOTSTRAP_NAME=Your Name
# PLATFORM_IP_ALLOWLIST=127.0.0.1,::1

# Observability (optional)
# SENTRY_DSN=

